# Скопируйте в .env рядом с docker-compose.yml (файл .env в git не коммитится).

# Пароль Postgres в compose (только для локального/VPS Docker)
POSTGRES_PASSWORD=change-me-long-random

# Секреты приложения (обязательны в продакшене)
ADMIN_PASSWORD=
SESSION_SECRET=

# Опционально: реальный штат при первом запуске пустой БД (одна строка JSON)
# STAFF_SEED_JSON={"departments":[...]}

# Опционально: письма с кодом входа сотрудника (Resend)
# RESEND_API_KEY=
# MAIL_FROM="Коробка желаний <noreply@ваш-домен.ru>"

APP_PORT=3000